{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/*.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-catalogo-publico",
      "urls": [
        "https://prybinaback.onrender.com/api/productos$",
        "https://prybinaback.onrender.com/api/productos?*$",
        "https://prybinaback.onrender.com/api/marcas$",
        "https://prybinaback.onrender.com/api/marcas?*$",
        "https://prybinaback.onrender.com/api/familias$",
        "https://prybinaback.onrender.com/api/familias?*$",
        "https://prybinaback.onrender.com/api/ofertas$",
        "https://prybinaback.onrender.com/api/ofertas?*$",
        "https://prybinaback.onrender.com/api/carruseles$",
        "https://prybinaback.onrender.com/api/carruseles?*$",
        "https://prybinaback.onrender.com/api/productos/[0-9a-fA-F]{24}$",
        "https://prybinaback.onrender.com/api/productos/[0-9a-fA-F]{24}?*$"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1d",
        "timeout": "10s"
      },
      "version": 2,
      "cacheQueryOptions": {
        "ignoreSearch": false
      }
    },
    {
      "name": "imagenes-productos",
      "urls": ["https://res.cloudinary.com/da8xounzu/image/upload/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 150,
        "maxAge": "7d",
        "cacheOpaqueResponses": true
      }
    },
    {
      "name": "google-fonts",
      "urls": [
        "https://fonts.googleapis.com/**",
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 20,
        "maxAge": "7d",
        "timeout": "5s"
      }
    }
  ]
}
